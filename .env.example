# Supabase project settings (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key, or the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only key (the "service_role" key, or the newer "secret" key sb_secret_...).
# Used to save game scores, create student accounts and reset passwords.
# Never expose it in the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Students who sign up with a phone number get an internal login email on this domain.
# They never see it; they always log in with their phone number.
PHONE_EMAIL_DOMAIN=students.hamthalah.app
